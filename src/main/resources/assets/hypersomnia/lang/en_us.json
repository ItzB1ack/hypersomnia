  "hypersomnia.subtitle.voice.start_early": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oWho are you? \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.start_loop": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oThere you are. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.start_accuse": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oIt's you. It's always you. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.start_rage": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oHow can you sleep? \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_early_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oWait. Please. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_early_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oWhere am I? \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_loop_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oDon't go. Not again. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_loop_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oI was too late. Too late. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_accuse_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oYou were asleep. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_accuse_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oYou forgot her. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_rage_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oWake up. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.run_rage_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oThis isn't a dream. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.escape_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oDon't leave me here. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.escape_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oYou always leave. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.blocked_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oLet me in. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.blocked_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oOpen the door. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.caught_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oI've got you. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.caught_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oNow you're awake. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.stared": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oYou see me. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.pause_0": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oThere's no pause here. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.pause_1": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oYou may not end a session early. \u00a7r\u00a7d\u00a7kXX\u00a7r",
  "hypersomnia.subtitle.voice.pause_2": "\u00a7d\u00a7kXX\u00a7r \u00a7d\u00a7oWhy won't you listen? Stay. With me. \u00a7r\u00a7d\u00a7kXX\u00a7r"
}
